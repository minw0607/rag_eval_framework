# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── LLM Provider (OpenAI-compatible endpoint) ─────────────────────────────────
# Works with: OpenAI, Azure OpenAI, Ollama, Together, Groq, Anyscale, LM Studio
#
# OpenAI (direct):
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_API_KEY=sk-...
#
# Azure OpenAI:
#   OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/deployments/<deployment>
#   OPENAI_API_KEY=<your-azure-key>
#   OPENAI_API_VERSION=2025-04-01-preview   # Azure only
#
# Ollama (local, free):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here

# Azure-only — leave blank for other providers
OPENAI_API_VERSION=

# ── Model Deployments ──────────────────────────────────────────────────────────
# Set to your deployment name (Azure) or model ID (OpenAI/others)
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Embedding choice: "large" | "small" | "local" ────────────────────────────
# "local" uses sentence-transformers (free, no API key needed)
EMBEDDING_CHOICE=small
