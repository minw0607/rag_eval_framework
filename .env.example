# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
#
# The framework auto-detects your provider:
#   OPENAI_API_VERSION is set   → Azure OpenAI
#   OPENAI_API_VERSION is blank → OpenAI (direct) or any compatible endpoint
#
# See docs/provider-setup.md for detailed setup instructions.

# =============================================================================
# OPTION A: Azure OpenAI  (uncomment and fill in)
# =============================================================================
# OPENAI_BASE_URL=https://<your-resource-name>.openai.azure.com
# OPENAI_API_KEY=<your-azure-key>
# OPENAI_API_VERSION=2025-04-01-preview
# OPENAI_GENERATION_MODEL=<your-generation-deployment-name>
# OPENAI_EMBEDDING_MODEL=<your-embedding-deployment-name>
#
# If your Azure endpoint is behind an API Management (APIM) gateway
# (e.g. https://company.com/YourGatewayPath instead of *.openai.azure.com),
# set the custom header name and value your gateway expects.
# The header name is usually derived from your gateway path or gateway docs.
# OPENAI_APIM_HEADER_NAME=<your-gateway-subscription-key-header-name>
# OPENAI_APIM_SUBSCRIPTION_KEY=<your-apim-subscription-key>

# =============================================================================
# OPTION B: OpenAI (direct)  (uncomment and fill in)
# =============================================================================
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_GENERATION_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# OPTION C: Ollama (local, free — no API key needed)
# =============================================================================
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_GENERATION_MODEL=llama3
# EMBEDDING_CHOICE=local   # uses sentence-transformers, no API call

# =============================================================================
# OPTION D: Other OpenAI-compatible providers
# =============================================================================
# Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Together:   OPENAI_BASE_URL=https://api.together.xyz/v1
# LM Studio:  OPENAI_BASE_URL=http://localhost:1234/v1

# =============================================================================
# ACTIVE CONFIGURATION  ← fill in the values for your chosen provider above
# =============================================================================

OPENAI_BASE_URL=
OPENAI_API_KEY=

# Azure only — leave blank for all other providers
OPENAI_API_VERSION=

# Model names (deployment names for Azure, model IDs for others)
OPENAI_GENERATION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding mode: "large" | "small" | "local"
# "local" uses sentence-transformers (free, works without an embedding API)
EMBEDDING_CHOICE=small

# HotpotQA data file — download from https://hotpotqa.github.io/
HOTPOTQA_DATA_PATH=./data/hotpot_train_v1.1.json
